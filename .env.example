# Template. Copy (do not move) this file to .env and fill in the key:
#   copy .env.example .env
# .env is gitignored and must never be committed. This file is committed.

# --- Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model used to answer questions.
LLM_MODEL=openai/gpt-4o-mini
# A different model grades answers in the offline evaluation.
JUDGE_MODEL=anthropic/claude-haiku-4.5

# --- Vector store ---
# Two ways to run Qdrant. Leave QDRANT_PATH empty to talk to a server
# (docker compose up -d qdrant). Set it to a folder and Qdrant runs embedded
# inside the app instead - no Docker, no server. Embedded storage allows one
# process at a time.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_COLLECTION=contract_chunks

# --- Retrieval ---
# dense | sparse | hybrid. Hybrid is the default: it is the only mode that
# retrieves the redacted-price and placeholder-date clauses. See
# docs/retrieval-eval.md for the comparison.
SEARCH_MODE=hybrid
TOP_K=8
# Relevance gate: refuse before calling the model when the closest chunk's
# dense cosine similarity is below this. 0 = off. Run
# `uv run scripts/calibrate_gate.py` to choose a value from your own data.
# Calibrated on this corpus: off-topic queries top out at 0.55, the weakest
# genuine question scores 0.63. It rejects questions that are not about these
# contracts; it CANNOT tell whether the corpus can answer a contract question.
MIN_SCORE=0.56
# Let the model correct an invented citation once before it is dropped.
CITATION_RETRY=true

# --- Prompts and guards ---
PROMPT_VERSION=v5
MASKING_ENABLED=false
