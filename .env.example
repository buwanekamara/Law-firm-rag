# Template. Copy (do not move) this file to .env and fill in the key:
#   copy .env.example .env
# .env is gitignored and must never be committed. This file is committed.
#
# Every variable below is required. The code holds no fallback values, so a
# missing one stops the application at startup with a message naming it,
# rather than quietly running on a setting nobody chose.

# --- Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model used to answer questions.
LLM_MODEL=openai/gpt-4o-mini
# A different model grades answers in the offline evaluation.
JUDGE_MODEL=anthropic/claude-haiku-4.5
# 0 = as repeatable as the gateway allows. Not the same as deterministic:
# repeated runs of the same question still vary slightly.
LLM_TEMPERATURE=0

# --- Vector store ---
# Two ways to run Qdrant. Leave QDRANT_PATH empty to talk to a server
# (docker compose up -d qdrant). Set it to a folder and Qdrant runs embedded
# inside the app instead - no Docker, no server. Embedded storage allows one
# process at a time.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_COLLECTION=contract_chunks
# The two embedding models. Changing either one invalidates the stored index:
# re-run scripts/index.py afterwards.
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# --- Retrieval ---
# dense | sparse | hybrid. Hybrid is the measured choice: it is the only mode
# that retrieves the redacted-price and placeholder-date clauses. See
# docs/retrieval-eval.md for the comparison.
SEARCH_MODE=hybrid
TOP_K=8
# Each half of a hybrid search fetches this multiple of TOP_K before fusion.
PREFETCH_MULTIPLIER=4
# Relevance gate: refuse before calling the model when the closest chunk's
# dense cosine similarity is below this. 0 = off. Run
# `uv run scripts/calibrate_gate.py` to choose a value from your own data.
# Calibrated on this corpus: off-topic queries top out at 0.55, the weakest
# genuine question scores 0.63. It rejects questions that are not about these
# contracts; it CANNOT tell whether the corpus can answer a contract question.
MIN_SCORE=0.56
# Let the model correct an invented citation once before it is dropped.
CITATION_RETRY=true

# --- Ingestion ---
# Chunk size in words, and the overlap between the pieces of a split section.
# Changing either makes the stored chunks disagree with this file: re-run
# scripts/extract.py, scripts/chunk.py and scripts/index.py afterwards.
CHUNK_MAX_WORDS=350
CHUNK_OVERLAP_WORDS=50
# Lower this on a memory-constrained host.
EMBED_BATCH_SIZE=32

# --- Conversation ---
# Previous exchanges carried into a follow-up question.
HISTORY_TURNS=6

# --- Gateway ---
LLM_TIMEOUT_SECONDS=90

# --- Prompts and guards ---
PROMPT_VERSION=v5
MASKING_ENABLED=false
# Presidio's confidence floor. Below 0.6 a ZIP+4 gets mistaken for a social
# security number; genuine detections in this corpus score 0.85 or above.
MASKING_MIN_CONFIDENCE=0.6
