# Copy to .env and add your key:  copy .env.example .env
# .env is gitignored. This file is committed.
#
# Every variable here is required - the code has no fallback values, so a
# missing one stops startup with a message naming it.
#
# Each entry below says what it accepts and what changes when you change it.
# A few need work re-running afterwards; those say so.

# --- Gateway ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Any model id the gateway accepts. List them: uv run scripts/ask.py --models
# Bigger models follow the prompt rules more closely and cost more per answer.
LLM_MODEL=openai/gpt-4o-mini
# The grader in eval/. Keep it a different vendor from LLM_MODEL so the
# answering model is not marking its own work.
JUDGE_MODEL=anthropic/claude-haiku-4.5
# 0.0-2.0. Leave at 0 for evaluation: anything higher makes the same question
# score differently run to run. Raise only to see how varied the answers get.
LLM_TEMPERATURE=0
# Seconds before a gateway call is abandoned. Raise if a slow model times out.
LLM_TIMEOUT_SECONDS=90

# --- Vector store ---
# Leave QDRANT_PATH empty to use a server (docker compose up -d qdrant).
# Set it to a folder - ./qdrant_local - to run Qdrant inside this process:
# no Docker, but one process at a time, so stop the API before re-indexing.
# QDRANT_URL=:memory: gives a throwaway index that dies with the process.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
# Change to keep two indexes side by side - one per chunking setting, say -
# and switch between them without re-running anything.
QDRANT_COLLECTION=contract_chunks
# Any fastembed model id. bge-base and bge-large score slightly better and are
# slower; the dimension is read from the model, so nothing else needs editing.
# Changing either one invalidates the index: re-run scripts/index.py.
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# --- Retrieval ---
# dense | sparse | hybrid.
#   dense   meaning only - misses clauses whose value is redacted or blank
#   sparse  exact words only - misses questions phrased in your own words
#   hybrid  both, fused by rank
# Compare them yourself: uv run eval/retrieval_eval.py
SEARCH_MODE=hybrid
# Excerpts sent to the model, 1-20. Lower is cheaper and faster but drops
# sections that answer part of a question; higher dilutes the prompt.
# See the effect: uv run eval/retrieval_eval.py --k 5
TOP_K=8
# 1-10. Each half of a hybrid search fetches this multiple of TOP_K before
# fusion. Higher lets a chunk ranked low by one search but high by the other
# still surface; below 2 there is little for the fusion to work with.
PREFETCH_MULTIPLIER=4
# 0.0-1.0. Refuse before calling the model when the closest chunk scores
# below this. 0 turns the gate off. Too high refuses real questions, so
# measure rather than guess: uv run scripts/calibrate_gate.py
MIN_SCORE=0.56
# true | false. Let the model fix an invented citation once before it is
# dropped. false is one call cheaper and shows the raw failure rate.
CITATION_RETRY=true

# --- Ingestion ---
# CHUNK_MAX_WORDS 100-400. Above ~380 the embedding model truncates the tail
# of a clause; below ~150 sections get split that should stay whole.
# CHUNK_OVERLAP_WORDS is how much of the previous piece is repeated when a
# section is split, so a sentence on the boundary survives somewhere.
# Changing either: re-run scripts/extract.py, scripts/chunk.py, scripts/index.py
# Then check the result: uv run scripts/chunk.py --sizes
CHUNK_MAX_WORDS=350
CHUNK_OVERLAP_WORDS=50
# Chunks embedded at once. Lower it if indexing runs out of memory; it changes
# speed and nothing else.
EMBED_BATCH_SIZE=32

# --- Conversation ---
# 0-20 previous exchanges carried into a follow-up. 0 disables follow-ups.
# Higher drags retrieval back towards whatever was discussed first.
HISTORY_TURNS=6

# --- Prompts and guards ---
# v1 | v2 | v3 | v4 | v5 - the files in app/generate/prompts/answer_*.md.
# Add a v6 by copying one and it appears here with no code change.
# Compare: uv run eval/answer_eval.py --versions v4 v5
PROMPT_VERSION=v5
# true | false. Replace names and contact details with placeholders before
# the text is sent. Needs the spaCy model - see the README.
# Preview what it would remove: uv run scripts/mask.py --corpus
MASKING_ENABLED=false
# 0.0-1.0. Presidio's confidence floor. Below 0.6 a ZIP+4 gets masked as a
# social security number; above ~0.9 real names start slipping through.
MASKING_MIN_CONFIDENCE=0.6
