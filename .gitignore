# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

*.pdf

# Virtual environments
.venv

# Secrets — never commit
.env

# Pipeline outputs (regenerated by the debug scripts).
# The folders are kept in git via .gitkeep; their contents are not.
data/extracted/*
data/chunks/*
!data/extracted/.gitkeep
!data/chunks/.gitkeep

# Local Qdrant storage (Docker volume or embedded mode)
qdrant_data/
qdrant_local/

# Tooling caches
.ruff_cache/
.pytest_cache/
